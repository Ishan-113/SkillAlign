# MongoDB Atlas
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/sih134?retryWrites=true&w=majority
MONGO_DB_NAME=sih134
API_PORT=8000

# ---------------------------------------------------------------------------
# Job ingestion - Adzuna Jobs API (https://developer.adzuna.com/)
# Leave blank to fall back to generated/mock data until a key is obtained.
# These are read from environment / GitHub Actions secrets. Never hardcode.
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_BASE_URL=https://api.adzuna.com/v1/api/jobs
ADZUNA_MAX_PAGES=10
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_REQUEST_DELAY=1.0

# When true (default), ingestion uses generated mock data when no valid job API
# key is configured so the app remains functional for development/demos.
ENABLE_MOCK_FALLBACK=true

# ---------------------------------------------------------------------------
# Scheduling / freshness
# ---------------------------------------------------------------------------
JOBS_UPDATE_INTERVAL_HOURS=6
CURRICULUM_UPDATE_INTERVAL_DAYS=30
STALE_JOB_DAYS=30
